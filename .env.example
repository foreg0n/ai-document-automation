# Copy this file to .env. Never commit your actual API key.
# API root, without /chat/completions. Other compatible providers can be used.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Use an exact model ID available in your provider account.
LLM_MODEL=
LLM_API_KEY=
# json_schema requires model/endpoint support. json_object is an explicit fallback.
LLM_RESPONSE_FORMAT=json_schema
LLM_TIMEOUT_SECONDS=60
